  - family-names: Pham
    given-names: Anh Dung
repository-code: "https://github.com/QuyenAnh2002/wifi-roaming-logger"
license: GPL-3.0-or-later
keywords:
  - Wi-Fi
  - Android
  - Wi-Fi RTT
  - IEEE 802.11mc
  - RSSI
  - indoor positioning
references:
